{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "resourceGroupName": {
      "value": "${AZURE_RESOURCE_GROUP}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "openAiServiceName": {
      "value": "${AZURE_OPENAI_SERVICE}"
    },
    "openAiResourceGroupName": {
      "value": "${AZURE_OPENAI_RESOURCE_GROUP}"
    },
    "openAiSkuName": {
      "value": "S0"
    },
    "formRecognizerServiceName": {
      "value": "${AZURE_FORMRECOGNIZER_SERVICE}"
    },
    "formRecognizerResourceGroupName": {
      "value": "${AZURE_FORMRECOGNIZER_RESOURCE_GROUP}"
    },
    "formRecognizerSkuName": {
      "value": "S0"
    },
    "searchIndexName": {
      "value": "${AZURE_SEARCH_INDEX=gptkbindex}"
    },
    "searchServiceName": {
      "value": "${AZURE_SEARCH_SERVICE}"
    },
    "searchServiceResourceGroupName": {
      "value": "${AZURE_SEARCH_SERVICE_RESOURCE_GROUP}"
    },
    "storageAccountName": {
      "value": "${AZURE_STORAGE_ACCOUNT}"
    },
    "storageResourceGroupName": {
      "value": "${AZURE_STORAGE_RESOURCE_GROUP}"
    },
    "chatGptDeploymentName": {
      "value": "${AZURE_OPENAI_CHATGPT_DEPLOYMENT=chat}"
    },
    "chatGptModelName": {
      "value": "${AZURE_OPENAI_CHATGPT_MODEL_NAME=gpt-35-turbo}"
    },
    "chatGptModelVersion": {
      "value": "${AZURE_OPENAI_CHATGPT_MODEL_VERSION=0613}"
    },
    "embCapacity": {
      "value": "${AZURE_OPENAI_EMBEDDING_CAPACITY=100}"
    },
    "gptCapacity": {
      "value": "${AZURE_OPENAI_GPT_CAPACITY=60}"
    },
    "useApplicationInsights": {
      "value": "${AZURE_USE_APPLICATION_INSIGHTS=true}"
    },
    "authRole": {
      "value": "${AZURE_AUTH_ROLE}"
    },
    "authTenant": {
      "value": "${AZURE_AUTH_TENANT}"
    },
    "redeployOpenAI": {
      "value": "${AZURE_REDEPLOY_OPENAI=true}"
    },
    "allowed_cors": {
      "value": "${AZURE_ALLOWED_CORS}"
    },
    "authClient": {
      "value": "${AZURE_AUTH_ClIENT}"
    },
    "authProvider": {
      "value": "${AZURE_AUTH_PROVIDER='microsoft'}"
    },
    "appServicePlanSku": {
      "value": "${AZURE_APPSERVICE_SKU=B1}"
    },
    "searchServiceSkuName": {
      "value": "${AZURE_SEARCH_SERVICE_SKU=standard}"
    },
    "icuClientId": {
      "value": "${AZURE_AUTH_ICU_CLIENT}"
    },
    "icuIssuerUrl": {
      "value": "${AZURE_AUTH_ICU_ISSUER_URL}"
    },
    "apiBasePath": {
      "value": "${API_BASE_PATH}"
    }
  }
}