{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "resourceGroupName": {
      "value": "${AZURE_RESOURCE_GROUP}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "openAiServiceName": {
      "value": "${AZURE_OPENAI_SERVICE}"
    },
    "openAiResourceGroupName": {
      "value": "${AZURE_OPENAI_RESOURCE_GROUP}"
    },
    "openAiSkuName": {
      "value": "S0"
    },
    "formRecognizerServiceName": {
      "value": "${AZURE_FORMRECOGNIZER_SERVICE}"
    },
    "formRecognizerResourceGroupName": {
      "value": "${AZURE_FORMRECOGNIZER_RESOURCE_GROUP}"
    },
    "formRecognizerSkuName": {
      "value": "S0"
    },
    "formRecognizerDeployNewResource": {
      "value": "${AZURE_FORMRECOGNIZER_DEPLOY_NEW_RESOURCE='true'}"
    },
    "searchIndexName": {
      "value": "${AZURE_SEARCH_INDEX=gptkbindex}"
    },
    "searchServiceName": {
      "value": "${AZURE_SEARCH_SERVICE}"
    },
    "searchServiceResourceGroupName": {
      "value": "${AZURE_SEARCH_SERVICE_RESOURCE_GROUP}"
    },
    "searchServiceDeployNewResource": {
      "value": "${AZURE_SEARCH_SERVICE_DEPLOY_NEW_RESOURCE='true'}"
    },
    "storageAccountName": {
      "value": "${AZURE_STORAGE_ACCOUNT}"
    },
    "storageResourceGroupName": {
      "value": "${AZURE_STORAGE_RESOURCE_GROUP}"
    },
    "chatGptDeploymentName": {
      "value": "${AZURE_OPENAI_CHATGPT_DEPLOYMENT=chat}"
    },
    "chatGptModelName": {
      "value": "${AZURE_OPENAI_CHATGPT_MODEL_NAME=gpt-4o}"
    },
    "chatGptModelVersion": {
      "value": "${AZURE_OPENAI_CHATGPT_MODEL_VERSION=2024-11-20}"
    },
    "embCapacity": {
      "value": "${AZURE_OPENAI_EMBEDDING_CAPACITY=100}"
    },
    "gptCapacity": {
      "value": "${AZURE_OPENAI_CHATGPT_CAPACITY=60}"
    },
    "chatGptDeploymentSkuName": {
      "value": "${AZURE_OPENAI_CHATGPT_SKU_NAME=Standard}"
    },
    "useApplicationInsights": {
      "value": "${AZURE_USE_APPLICATION_INSIGHTS=true}"
    },
    "usePrivateLinkScope": {
      "value": "${AZURE_USE_PRIVATE_LINK_SCOPE=true}"
    },
    "authRole": {
      "value": "${AZURE_AUTH_ROLE}"
    },
    "authTenant": {
      "value": "${AZURE_AUTH_TENANT}"
    },
    "openAiDeployNewResource": {
      "value": "${AZURE_OPENAI_DEPLOY_NEW_RESOURCE='true'}"
    },
    "allowed_cors": {
      "value": "${AZURE_ALLOWED_CORS}"
    },
    "tls_cipher_suite": {
      "value": "${AZURE_TLS_CIPHER_SUITE=TLS_AES_128_GCM_SHA256}"
    },
    "authClient": {
      "value": "${AZURE_AUTH_ClIENT}"
    },
    "authProvider": {
      "value": "${AZURE_AUTH_PROVIDER='microsoft'}"
    },
    "appServicePlanSku": {
      "value": "${AZURE_APPSERVICE_SKU=P0v3}"
    },
    "searchServiceSkuName": {
      "value": "${AZURE_SEARCH_SERVICE_SKU=standard}"
    },
    "searchServiceLocation": {
      "value": "${AZURE_SEARCH_SERVICE_LOCATION}"
    },
    "vnetResourceGroupName": {
      "value": "${AZURE_VNET_RESOURCE_GROUP}"
    },
    "vnetName": {
      "value": "${AZURE_VNET_NAME}"
    },
    "subnetName": {
      "value": "${AZURE_SUBNET_NAME}"
    },
    "subnetName_AppService": {
      "value": "${AZURE_SUBNET_NAME_APPSERVICE}"
    },
    "deployKey": {
      "value": "${AZURE_DEPLOY_KEY='true'}"
    },
    "deployLink": {
      "value": "${AZURE_DEPLOY_LINK='true'}"
    },
    "icuClientId": {
      "value": "${AZURE_AUTH_ICU_CLIENT}"
    },
    "icuIssuerUrl": {
      "value": "${AZURE_AUTH_ICU_ISSUER_URL}"
    },
    "apiBasePath": {
      "value": "${API_BASE_PATH}"
    },
    "ipSecurityRestrictionIp": {
      "value": "${AZURE_GATEWAY_RESTRICTION_IP}"
    }
  }
}
